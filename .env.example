# Provision Upstash Redis from the Vercel Marketplace; these are injected automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Shared edit PIN. Set only in Vercel Environment Variables.
EDIT_PIN=

# Optional. Leave unset for same-origin Vercel hosting.
# For GitHub Pages frontend, set to https://sri-akshat.github.io
ALLOWED_ORIGIN=
